# ConnectLocal API - Environment Configuration Example
# Copy to .env and configure real credentials.
# NEVER commit real secret values to version control.

PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# MongoDB Connection String
MONGODB_URI=mongodb://localhost:27017/connectlocal

# Security Secrets (Must be at least 16 characters)
JWT_SECRET=change-me-min-16-chars
ADMIN_KEY=change-me-min-16-chars

# Cloudinary (Profile Photo Uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase (Auth Verification - Future)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Rate Limits (Daily caps)
RATE_LIMIT_CONNECT_PER_DAY=20
RATE_LIMIT_REPORT_PER_DAY=10
